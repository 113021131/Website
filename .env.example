# Copy to .env.local (never commit .env.local).

# Supabase project URL and publishable key (Dashboard → Project Settings → API).
# Both are safe to expose in the browser; Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public origin of the site, no trailing slash. TODO_OWNER: production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Supabase service-role / secret key is NOT used by this app. Do not add it here.
